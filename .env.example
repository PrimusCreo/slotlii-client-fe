# API
# Leave blank in local dev to use the Vite proxy at `/api` -> http://localhost:3000.
# In prod, set the full origin including the `/api` prefix, e.g. https://api.slotlii.com/api
VITE_API_BASE_URL=

# Meta / Facebook App — Embedded Signup
VITE_FACEBOOK_APP_ID=
VITE_FACEBOOK_CONFIG_ID=
VITE_META_GRAPH_API_VERSION=v25.0

# Twilio Partner Solution ID (WhatsApp Tech Provider Program).
# Found in the Meta App Dashboard after you accept Twilio's Partner
# Solution request for the app. Passed into Embedded Signup via
# extras.setup.solutionID so Meta shares each customer's newly created
# WABA with Twilio — without it, Twilio can't claim the WABA and sender
# registration fails with error 63101.
# NOTE: a WABA created before this was configured cannot be attached to
# the Partner Solution retroactively; the customer must create a new one.
VITE_FACEBOOK_SOLUTION_ID=
